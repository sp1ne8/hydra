{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "express",
  "functions": {
    "app.js": {
      "includeFiles": "public/**"
    }
  },
  "redirects": [
    {
      "source": "/admin",
      "destination": "/admin/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
